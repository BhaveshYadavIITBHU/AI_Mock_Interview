# Database URL (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OAuth Callback URL (Use http://localhost:5000/api/auth/google/callback for local dev, or https://ai-mock-interview-xnfn.onrender.com/api/auth/google/callback for production)
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# Frontend Application URL (Use http://localhost:5173 for local, or https://ai-mock-interview-blue-eight.vercel.app for production)
FRONTEND_URL="http://localhost:5173"

# JWT Secrets for Stateless Authentication & Refresh Tokens
JWT_SECRET="your-jwt-secret-key"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key"

# Google Gemini API Key
GEMINI_API_KEY="your-gemini-api-key"

PORT=5000
